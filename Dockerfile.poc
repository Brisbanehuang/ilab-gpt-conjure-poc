FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && apt-get clean \
    && find /var/lib/apt/lists -type f -delete

COPY requirements-webui.txt pyproject.toml ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-webui.txt

COPY codex_image ./codex_image
COPY scripts ./scripts

EXPOSE 8787

CMD ["python", "-m", "uvicorn", "codex_image.webui.app:app", "--host", "0.0.0.0", "--port", "8787", "--no-access-log"]
