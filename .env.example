# The share build works without an .env file. Copy this file to .env only when
# using docker-compose.share.yml or the optional Sub2API login bridge.

OMNI_POC_MODE=false
OMNI_BASE_URL=http://host.docker.internal:8080/v1
OMNI_IMAGE_MODEL=gpt-image-2

# Required only when OMNI_POC_MODE=true.
OMNI_POC_SECRET_KEY=
OMNI_POC_LOGIN_URL=
OMNI_POC_DASHBOARD_URL=
OMNI_POC_AUTH_ORIGINS=
OMNI_POC_SOURCE_URL=https://github.com/Brisbanehuang/ilab-gpt-conjure-poc/tree/share/v0.2.25

# Example bridge values:
# OMNI_POC_LOGIN_URL=https://portal.example.com/image-generator
# OMNI_POC_DASHBOARD_URL=https://portal.example.com/dashboard
# OMNI_POC_AUTH_ORIGINS=https://portal.example.com

# Local storage is the safe default. Configure R2/S3-compatible storage only
# after reviewing codex_image/webui/object_storage.py and your retention policy.
OMNI_OBJECT_STORAGE_DRIVER=local
